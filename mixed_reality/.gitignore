# =========================================================
#  Unity .gitignore (Unity 6 + VR Template / OpenXR / XRI)
# =========================================================

# --- Door Unity gegenereerde mappen (in de projectroot) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Visual Stcludio cache
.vs/

# Gradle cache (Android / Quest builds)
.gradle/

# Autogenerated VS/Rider/MonoDevelop solution- en projectbestanden
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta-bestanden van genegeerde PDB/MDB-bestanden
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# --- Builds ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crashlytics
crashlytics-build.properties

# Addressables (gegenereerde buildcontent)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Gebruikersspecifieke en lokale XR / Editor instellingen ---
# Voorkomt merge conflicts tussen teamleden met verschillende OS/hardware/editor-voorkeuren
/[Aa]ssets/XR/UserSimulationSettings/
/[Aa]ssets/XR/UserSimulationSettings.meta
/[Aa]ssets/CompositionLayers/UserSettings/
/[Aa]ssets/CompositionLayers/UserSettings.meta
/[Aa]ssets/XR/Settings/OpenXR Editor Settings.asset*
/[Aa]ssets/XRI/Settings/XRInteractionEditorSettings.asset*

# --- Editors / IDE's ---
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- Blender ---
# Automatische back-ups van .blend-bestanden
*.blend1
*.blend2

# =========================================================
#  LET OP: deze mappen NIET negeren, ze horen in git:
#   Assets/            (incl. alle .meta-bestanden!)
#   Packages/          (manifest.json + packages-lock.json)
#   ProjectSettings/   (incl. XR Plug-in Management / OpenXR)
#   Assets/XR/         (XR-loaders en OpenXR-instellingen)
#   Assets/XRI/        (XR Interaction Toolkit-settings)
#   Assets/Samples/    (XRI Starter Assets van de template)
# =========================================================